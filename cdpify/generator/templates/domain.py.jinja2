{{ header }}

{{ future_annotations }}
{% if typing_names %}

from typing import {{ typing_names | join(", ") }}
{% endif %}

from cdpify.codec import decode_cdp, encode_cdp
from cdpify.executor import CommandExecutor
{% if has_deprecated %}
from cdpify.shared.decorators import deprecated
{% endif %}
{% if command_imports %}

from .commands import (
    {{ command_imports | join(",\n    ") }},
)
{% endif %}
{% if local_type_names %}
from .types import (
    {{ local_type_names | join(",\n    ") }},
)
{% endif %}
{% if cross_domain_modules %}

if TYPE_CHECKING:
    from cdpify.domains import {{ cross_domain_modules | join(", ") }}
{% endif %}

class {{ domain_name }}:
    def __init__(self, executor: CommandExecutor) -> None:
        self._executor = executor
{% for method in methods %}

{% if method.deprecation %}
    @deprecated("{{ method.deprecation }}")
{% endif %}
    async def {{ method.name }}(
        self,
{% if method.parameters %}
        *,
        {{ method.parameters | map(attribute="declaration") | join(",\n        ") }},
{% endif %}
    ) -> {{ method.return_type }}:
{% if method.docstring %}
{{ method.docstring }}
{% endif %}
{% if method.params_model %}
        params = {{ method.params_model }}({{ method.constructor_args }})

{% endif %}
{% if method.result_model %}
        result = await self._executor.execute(
            method={{ domain_name }}Command.{{ method.command_member }},
            params={% if method.params_model %}encode_cdp(params){% else %}None{% endif %},
        )
        return decode_cdp({{ method.result_model }}, result)
{% else %}
        await self._executor.execute(
            method={{ domain_name }}Command.{{ method.command_member }},
            params={% if method.params_model %}encode_cdp(params){% else %}None{% endif %},
        )
{% endif %}
{% endfor %}
